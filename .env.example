# Copy this file to .env and adjust as needed. Every variable is prefixed SEC_FETCHER_
# and is read by src/sec_fetcher/config.py. Anything left unset falls back to the default
# shown here.

SEC_FETCHER_COMPANY_PROVIDER=local_file
SEC_FETCHER_FILINGS_PER_COMPANY=1
SEC_FETCHER_FORM_TYPE=10-K
SEC_FETCHER_RATE_LIMIT_PER_SECOND=8
SEC_FETCHER_MAX_JOB_RETRIES=3
SEC_FETCHER_FETCH_WORKERS=4

# SEC asks that every request identify a real contact — replace this before running.
SEC_FETCHER_USER_AGENT="Your Name your-email@example.com"

SEC_FETCHER_COMPANIES_PATH=data/companies.json
SEC_FETCHER_RAW_DIR=data/raw
SEC_FETCHER_PDF_DIR=data/pdf
SEC_FETCHER_STATE_PATH=data/state.jsonl

# Disk cache of SEC's ticker->CIK bulk file, so a company without a pre-filled cik in
# companies.json doesn't trigger a multi-MB re-download on every run.
SEC_FETCHER_TICKER_CACHE_PATH=data/.ticker_cache.json
SEC_FETCHER_TICKER_CACHE_TTL_SECONDS=86400
